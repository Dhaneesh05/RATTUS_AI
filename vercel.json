{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "static/$1"
    },
    {
      "src": "/community",
      "dest": "community.html"
    },
    {
      "src": "/login",
      "dest": "login.html"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
